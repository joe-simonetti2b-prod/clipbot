# =====================================================================
#  Référence de toutes les variables.
#  Oracle : les principales sont en tête de deploy/oracle-cloud-init.sh
#  Render : demandées automatiquement à la création (render.yaml)
# =====================================================================

# --- OBLIGATOIRE : télécommande Telegram --------------------------------
TELEGRAM_BOT_TOKEN=            # donné par @BotFather
TELEGRAM_PAIR_CODE=            # un mot de passe inventé, ex : corse-2b-7481

# --- Quoi surveiller ------------------------------------------------------
# Chaînes à clipper, séparées par des virgules (Twitch par défaut, kick:xxx pour Kick).
# Laisser vide = veille automatique par tendances (nécessite les clés Twitch ci-dessous).
ALLOWED_CHANNELS=
LANGUAGES=fr
MIN_VIEWERS=1500
MAX_CONCURRENT_STREAMS=3
LONG_CLIPS=false               # true = clips de ~65 s (fonds créateurs > 1 min)

# --- Optionnel : veille par tendances Twitch (dev.twitch.tv/console) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_GAME_IDS=518203,509658  # Sports, Just Chatting

# --- Optionnel : transcription cloud gratuite (console.groq.com) --------
GROQ_API_KEY=

# --- Optionnel : textes IA + tri automatique (console.anthropic.com) ----
ANTHROPIC_API_KEY=
MIN_AI_SCORE=5
CTA_TEXT=
CHANNEL_TAGS=                  # ex : xqc=@xqc #xqcclips; kamet0=@kamet0
VIDEO_CREDIT=true              # crédit « twitch.tv/chaîne » incrusté en bas de la vidéo
AD_DISCLOSURE=false            # true si la légende contient un lien d'affiliation

# --- Optionnel : publication TikTok (developers.tiktok.com) --------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MODE=inbox              # inbox avant l'audit TikTok, direct après
AUTO_PUBLISH=false             # modifiable depuis Telegram : /auto on
TIKTOK_ANALYTICS=true          # stats + liste des vidéos (missions TikTok, lien auto pour Whop)
CONTACT_EMAIL=

# --- Optionnel : YouTube Shorts (console.cloud.google.com) ---------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public

# --- Rentabilité -------------------------------------------------------------
TARGET_LANG=fr                 # sous-titres traduits en français si le live est étranger
MIN_HYPE_SCORE=5
MAX_BACKLOG=3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# --- Optionnel : autres plateformes ---------------------------------------
YOUTUBE_API_KEY=               # souvent bloqué depuis les serveurs cloud
KICK_CLIENT_ID=                # nécessite aussi le webhook Kick
KICK_CLIENT_SECRET=

# --- Réglages avancés -------------------------------------------------------
WHISPER_MODEL=small            # tiny / base / small (si pas de Groq)
WHISPER_KEEP_LOADED=false
OUTPUT_HEIGHT=1920             # 1280 sur petite machine
X264_PRESET=veryfast           # ultrafast sur petite machine
TELEGRAM_OWNER_ID=             # évite de refaire /start (hébergeur sans disque)
PUBLIC_URL=                    # https://… si le bot a une adresse publique
RETENTION_DAYS=3
